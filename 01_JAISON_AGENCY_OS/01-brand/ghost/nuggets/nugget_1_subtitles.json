[
  {
    "start": "00:00:01.839",
    "end": "00:00:02.409",
    "text": "Abyśmy wszyscy"
  },
  {
    "start": "00:00:02.409",
    "end": "00:00:03.690",
    "text": "my"
  },
  {
    "start": "00:00:04.179",
    "end": "00:00:05.409",
    "text": "którzy są odpowiedzialni"
  },
  {
    "start": "00:00:08.900",
    "end": "00:00:09.419",
    "text": "za życie naszych"
  },
  {
    "start": "00:00:09.419",
    "end": "00:00:09.779",
    "text": "dzieci"
  },
  {
    "start": "00:00:11.559",
    "end": "00:00:12.990",
    "text": "zaczęli po"
  },
  {
    "start": "00:00:12.990",
    "end": "00:00:13.739",
    "text": "prostu reagować"
  },
  {
    "start": "00:00:14.159",
    "end": "00:00:14.989",
    "text": "na to co"
  },
  {
    "start": "00:00:14.989",
    "end": "00:00:15.329",
    "text": "się dzieje"
  },
  {
    "start": "00:00:16.359",
    "end": "00:00:17.159",
    "text": "na to jakie"
  },
  {
    "start": "00:00:17.159",
    "end": "00:00:17.849",
    "text": "treści są"
  },
  {
    "start": "00:00:17.849",
    "end": "00:00:18.419",
    "text": "przemycane"
  },
  {
    "start": "00:00:20.709",
    "end": "00:00:21.449",
    "text": "w social"
  },
  {
    "start": "00:00:21.449",
    "end": "00:00:22.209",
    "text": "mediach, jak"
  },
  {
    "start": "00:00:22.209",
    "end": "00:00:22.839",
    "text": "to wpływa"
  },
  {
    "start": "00:00:22.839",
    "end": "00:00:23.199",
    "text": "na te"
  },
  {
    "start": "00:00:23.199",
    "end": "00:00:23.389",
    "text": "dzieci"
  }
]
