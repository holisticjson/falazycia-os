# .streamlit/secrets.toml.example
# SKLOPIUJ TEN PLIK DO: secrets.toml I UZUPELNIJ WLASNE DANE (secrets.toml jest bezpiecznie ignorowany w gicie)

[gcp]
project_id = "jaison-agency-production"
location = "us-central1"
# Mozesz tu podac sciezke do klucza konta uslugowego GCP (Service Account JSON) lub pozostawic puste,
# jesli autoryzacja odbywa sie przez Application Default Credentials (ADC) na Twoim urzadzeniu.
service_account_path = "C:\\Aplikacje MVP\\01_JAISON_AGENCY_OS\\deploy_and_infra\\gcp-sa-key.json"

[database]
# Lokalna baza SQLite
sqlite_path = "data/clients.db"
# Konfiguracja zdalnej bazy danych PostgreSQL / AlloyDB (opcjonalnie)
db_host = "127.0.0.1"
db_port = 5432
db_name = "jaison_db"
db_user = "postgres"
db_password = "SUPER_SECURE_PASSWORD"

[api_keys]
# Klucze do zewnetrznych integracji (np. OpenAI, n8n, Systeme.io, itp.)
openai_api_key = "sk-proj-..."
context7_api_key = "ctx7sk-..."
n8n_webhook_url = "https://n8n.jason.pl/webhook/..."
systeme_io_api_key = "..."
