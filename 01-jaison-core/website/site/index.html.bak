              </div>
              <div style="display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 15px;">
                <a href="./clients/coolfon/brandbook/" target="_blank" style="font-size: 0.8rem; padding: 6px 12px; background: rgba(59, 130, 246, 0.1); color: #3B82F6; border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 6px; text-decoration: none; font-weight: bold; transition: all 0.2s;">Brand Book</a>
                <a href="./clients/coolfon/website/" target="_blank" style="font-size: 0.8rem; padding: 6px 12px; background: rgba(6, 182, 212, 0.1); color: #06B6D4; border: 1px solid rgba(6, 182, 212, 0.3); border-radius: 6px; text-decoration: none; font-weight: bold; transition: all 0.2s;">Strona WWW</a>
                <a href="./clients/coolfon/logo/" target="_blank" style="font-size: 0.8rem; padding: 6px 12px; background: rgba(255, 255, 255, 0.05); color: #FFF; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 6px; text-decoration: none; font-weight: bold; transition: all 0.2s;">Logotypy</a>
