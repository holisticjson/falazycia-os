      <!-- Section: Lead Capture (Google Calendar / Agent Integration) -->
      <section id="contact" style="padding: 100px 0; background: #050814; border-top: 1px solid rgba(255, 255, 255, 0.05); position: relative; overflow: hidden;">
        <div style="position: absolute; top: -100px; right: -100px; width: 300px; height: 300px; background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, transparent 70%); border-radius: 50%; pointer-events: none;"></div>
        <div style="position: absolute; bottom: -80px; left: -80px; width: 250px; height: 250px; background: radial-gradient(circle, rgba(6, 182, 212, 0.1) 0%, transparent 70%); border-radius: 50%; pointer-events: none;"></div>
        
        <div class="container" style="position: relative; z-index: 1;">
          <div style="display: flex; gap: 80px; flex-wrap: wrap; align-items: center;">
            
            <!-- Left Side: Persuasion -->
            <div style="flex: 1; min-width: 300px;">
              <span style="color: #3B82F6; font-size: 0.85rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.15em;">Krótka Konsultacja</span>
              <h2 style="font-size: 2.8rem; color: #FFF; margin-top: 10px; margin-bottom: 25px; line-height: 1.15; font-weight: 700;">Zarezerwuj 15-minutowe spotkanie.</h2>
              <p style="color: var(--slate-gray); font-size: 1.1rem; line-height: 1.6; margin-bottom: 30px;">
                Wybierz dogodny termin. Nasz system zintegrowany z **Google Calendar** automatycznie zarezerwuje i zaplanuje termin konsultacji w tle. Całością procesu zarządzają nasi wirtualni agenci (Hermes i Victor), którzy od razu po rezerwacji prześlą Ci powiadomienie.
              </p>
              
              <div style="display: flex; gap: 30px; margin-top: 40px; border-top: 1px dashed rgba(255, 255, 255, 0.08); padding-top: 30px;">
                <div>
                  <span style="display: block; font-size: 1.5rem; font-weight: 700; color: #3B82F6;">0 zł</span>
                  <span style="font-size: 0.8rem; color: var(--slate-gray); text-transform: uppercase; letter-spacing: 0.05em;">Koszt rozmowy</span>
                </div>
                <div style="border-left: 1px solid rgba(255, 255, 255, 0.08); padding-left: 30px;">
                  <span style="display: block; font-size: 1.5rem; font-weight: 700; color: #3B82F6;">Google Calendar</span>
                  <span style="font-size: 0.8rem; color: var(--slate-gray); text-transform: uppercase; letter-spacing: 0.05em;">Natywne połączenie</span>
                </div>
                <div style="border-left: 1px solid rgba(255, 255, 255, 0.08); padding-left: 30px;">
                  <span style="display: block; font-size: 1.5rem; font-weight: 700; color: #3B82F6;">Powiadomienie</span>
                  <span style="font-size: 0.8rem; color: var(--slate-gray); text-transform: uppercase; letter-spacing: 0.05em;">Natychmiast na e-mail</span>
                </div>
              </div>
            </div>

            <!-- Right Side: Sleek Glass Form -->
            <div style="flex: 1; min-width: 340px;">
              <div class="glass-card" id="contact-container" style="padding: 40px; background: rgba(10, 15, 29, 0.6); border-color: rgba(59, 130, 246, 0.2); text-align: left; border-radius: 16px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);">
                <h3 style="color: #FFF; margin-bottom: 8px; font-size: 1.6rem; font-family: var(--font-heading); font-weight: 700; text-align: center;">Wybierz Termin</h3>
                <p style="color: var(--slate-gray); margin-bottom: 25px; font-size: 0.9rem; text-align: center; line-height: 1.5;">Zostaw dane, a agent AI automatycznie zarezerwuje spotkanie w kalendarzu.</p>
                
                <form id="adhd-crm-form" style="display: flex; flex-direction: column; gap: 15px;">
                  <div>
                    <label for="client-name" style="display: block; color: rgba(255,255,255,0.7); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; font-weight: 600;">Twoje Imię / Nazwa Firmy</label>
                    <input type="text" id="client-name" name="name" required placeholder="np. Marek (Biuro Meble)" style="width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(5, 8, 20, 0.4); color: white; font-size: 0.95rem; outline: none; transition: border-color 0.2s;">
                  </div>
                  
                  <div>
                    <label for="client-email" style="display: block; color: rgba(255,255,255,0.7); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; font-weight: 600;">Adres E-mail</label>
                    <input type="email" id="client-email" name="email" required placeholder="np. marek@biuro.pl" style="width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(5, 8, 20, 0.4); color: white; font-size: 0.95rem; outline: none; transition: border-color 0.2s;">
                  </div>
                  
                  <div>
                    <label for="client-date" style="display: block; color: rgba(255,255,255,0.7); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; font-weight: 600;">Preferowany Dzień i Godzina</label>
                    <input type="datetime-local" id="client-date" name="date" required style="width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(5, 8, 20, 0.4); color: white; font-size: 0.95rem; outline: none; transition: border-color 0.2s;">
                  </div>

                  <div>
                    <label for="client-notes" style="display: block; color: rgba(255,255,255,0.7); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; font-weight: 600;">Co chcesz zautomatyzować?</label>
                    <textarea id="client-notes" name="notes" required rows="2" placeholder="np. Chcę automatycznie puszczać leady z reklam na mój WhatsApp." style="width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(5, 8, 20, 0.4); color: white; font-size: 0.95rem; outline: none; transition: border-color 0.2s; resize: vertical; line-height: 1.5;"></textarea>
                  </div>
                  
                  <button type="submit" id="submit-btn" class="btn-primary" style="display: block; width: 100%; font-size: 1.05rem; padding: 14px 0; border: none; border-radius: 8px; cursor: pointer; font-weight: 700; text-align: center; text-transform: uppercase; letter-spacing: 0.05em; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.35); transition: all 0.2s;">
                    Zarezerwuj Spotkanie w Kalendarzu ➔
                  </button>
                </form>
              </div>
            </div>
            
            <script>
              document.getElementById('adhd-crm-form').addEventListener('submit', function(e) {
                e.preventDefault();
                
                const btn = document.getElementById('submit-btn');
                const container = document.getElementById('contact-container');
                
                const name = document.getElementById('client-name').value;
                const email = document.getElementById('client-email').value;
                const date = document.getElementById('client-date').value;
                const notes = document.getElementById('client-notes').value;
                
                btn.disabled = true;
                btn.innerHTML = 'Przesyłanie...';
                
                const payload = { name: name, email: email, date: date, notes: notes };
                const webhookUrl = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' 
                  ? 'http://127.0.0.1:8090/webhook' 
                  : 'http://' + window.location.hostname + ':8090/webhook';
                
                fetch(webhookUrl, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(payload)
                })
                .then(response => {
                  if (response.ok) {
                    container.innerHTML = `
                      <div style="text-align: center; padding: 20px 0;">
                        <span style="font-size: 3.5rem; display: block; margin-bottom: 20px;">📅</span>
                        <h3 style="color: #3b82f6; margin-bottom: 15px; font-family: var(--font-heading); font-size: 1.5rem;">Termin Zarezerwowany!</h3>
                        <p style="color: rgba(255,255,255,0.9); font-size: 1.05rem; line-height: 1.6; margin-bottom: 10px;">
                          Nasze systemy agentowe AI pomyślnie zsynchronizowały termin z kalendarzem Google.
                        </p>
                        <p style="color: rgba(255,255,255,0.6); font-size: 0.9rem; line-height: 1.5;">
                          Potwierdzenie oraz link do spotkania zostały wysłane na adres <strong>${email}</strong>.
                        </p>
                      </div>
                    `;
                  } else {
                    throw new Error('Server error');
                  }
                })
                .catch(err => {
                  console.error('Webhook error, trying relative fallback...', err);
                  fetch('/webhook', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                  })
                  .then(response => {
                    if (response.ok) {
                      container.innerHTML = `
                        <div style="text-align: center; padding: 20px 0;">
                          <span style="font-size: 3.5rem; display: block; margin-bottom: 20px;">📅</span>
                          <h3 style="color: #3b82f6; margin-bottom: 15px; font-family: var(--font-heading); font-size: 1.5rem;">Termin Zarezerwowany!</h3>
                          <p style="color: rgba(255,255,255,0.9); font-size: 1.05rem; line-height: 1.6;">
                            Termin wpisany pomyślnie przez tunel relatywny.
                          </p>
                        </div>
                      `;
                    } else {
                      btn.disabled = false;
                      btn.innerHTML = 'Błąd serwera. Wyślij ponownie ➔';
                    }
                  })
                  .catch(fallbackErr => {
                    btn.disabled = false;
                    btn.innerHTML = 'Błąd sieci. Wyślij ponownie ➔';
                  });
                });
              });
            </script>

          </div>
        </div>
      </section>
    </main>

    <footer style="padding: 40px 0; background: #060f1a; color: rgba(255,255,255,0.4); text-align: center;">
      <div class="container">
