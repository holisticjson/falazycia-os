                    <input type="email" id="ebook2-email" name="email" required placeholder="np. tomasz@firma.pl" style="width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(5, 8, 20, 0.4); color: white; font-size: 0.95rem; outline: none; transition: border-color 0.2s;">
