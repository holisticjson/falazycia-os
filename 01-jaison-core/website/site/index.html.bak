              <div class="glass-card" style="padding: 30px; background: rgba(10, 15, 29, 0.4); border-color: rgba(59, 130, 246, 0.2); width: 100%; max-width: 380px; position: relative; overflow: hidden; border-radius: 20px;">
                <svg viewBox="0 0 400 400" width="100%" height="auto" style="display: block; max-width: 320px; margin: 0 auto; filter: drop-shadow(0 0 20px rgba(59, 130, 246, 0.25));">
