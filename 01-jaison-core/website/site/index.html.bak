      <!-- Pain Points Section -->
      <section id="problems" style="padding: 100px 0; background: #050814;">
        <div class="container">
          <div style="text-align: center; margin-bottom: 60px;">
            <span style="color: #EF4444; font-size: 0.85rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.15em;">Straty i Wąskie Gardła</span>
            <h2 style="font-size: 2.8rem; margin-top: 10px; margin-bottom: 20px; font-weight: 700;">Każdego dnia tracisz pieniądze. Nie widzisz tego.</h2>
            <p style="color: var(--slate-gray); font-size: 1.1rem; max-width: 650px; margin: 0 auto;">Zidentyfikuj krytyczne punkty zapalne w operacjach, przez które uciekają zyski i czas Twojego zespołu.</p>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
            <!-- Problem 1 -->
            <div class="glass-card" style="padding: 35px; border-top: 3px solid #EF4444; background: rgba(10, 15, 29, 0.45);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <span style="background: rgba(239, 68, 68, 0.15); color: #EF4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em;">Zabójcze dla zysku</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              </div>
              <h4 style="font-size: 1.3rem; margin-bottom: 15px; color: #FFF;">Wyciek leadów w 2 minuty</h4>
              <p style="color: var(--slate-gray); font-size: 0.95rem; line-height: 1.6;">
                Odpisujesz po godzinie? Badania pokazują jasno: **brak kontaktu w 2 minuty obniża szansę na konwersję o 391%**. Gorący lead stygnie błyskawicznie, a klient bez słowa przechodzi do konkurencji, która odpowiedziała natychmiast na czacie.
              </p>
            </div>

            <!-- Problem 2 -->
            <div class="glass-card" style="padding: 35px; border-top: 3px solid #F59E0B; background: rgba(10, 15, 29, 0.45);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <span style="background: rgba(245, 158, 11, 0.15); color: #F59E0B; border: 1px solid rgba(245, 158, 11, 0.3); padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em;">Utrata Skupienia</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
              </div>
              <h4 style="font-size: 1.3rem; margin-bottom: 15px; color: #FFF;">Paraliż decyzyjny i chaos kognitywny</h4>
              <p style="color: var(--slate-gray); font-size: 0.95rem; line-height: 1.6;">
                Ręczne przepisywanie danych między pocztą, CRM-em i arkuszami spowalnia pracę o 60%. Ciągłe przełączanie się między setkami otwartych kart i zakładek tworzy sztuczny szum i paraliżuje działanie liderów biznesowych.
              </p>
            </div>

            <!-- Problem 3 -->
            <div class="glass-card" style="padding: 35px; border-top: 3px solid #EF4444; background: rgba(10, 15, 29, 0.45);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <span style="background: rgba(239, 68, 68, 0.15); color: #EF4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em;">AI Ślepa Plama</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              </div>
              <h4 style="font-size: 1.3rem; margin-bottom: 15px; color: #FFF;">Niewidoczność w AI Search (AEO)</h4>
              <p style="color: var(--slate-gray); font-size: 0.95rem; line-height: 1.6;">
                Nowoczesne wyszukiwarki i asystenci AI zastępują Google. Ponad 87% marek jest kompletnie ignorowanych przez ChatGPT i Claude, ponieważ ich strony nie posiadają semantycznego kodu i ustrukturyzowanej wiedzy.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Systems Section -->
      <section id="services" style="padding: 100px 0; background: #0a0f1d;">
        <div class="container">
          <div style="text-align: center; margin-bottom: 60px;">
            <span style="color: #3B82F6; font-size: 0.85rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.15em;">Architektura Rezultatów</span>
            <h2 style="font-size: 2.8rem; margin-top: 10px; margin-bottom: 20px; font-weight: 700; color: #FFF;">Czyste wdrożenia. Zero zbędnego kodu.</h2>
            <p style="color: var(--slate-gray); font-size: 1.1rem; max-width: 650px; margin: 0 auto;">Odzyskaj od 10 do 30 godzin w tygodniu. Projektujemy dedykowane systemy agentowe AI sterowane bezpośrednio z komunikatorów, eliminując tarcie i setki otwartych zakładek.</p>
          </div>

          <div class="systems-grid">
            <!-- System 1 -->
            <div class="glass-card system-item" style="background: rgba(5, 8, 20, 0.5); border: 1px solid rgba(59, 130, 246, 0.15);">
              <div class="system-icon-wrapper" style="color: #3B82F6;">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
              </div>
              <h3 style="color: #FFF; font-size: 1.4rem; margin-bottom: 15px;">Lejki i Kwalifikacja (Agent Wiktor)</h3>
              <p style="color: var(--slate-gray); font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px;">
                Twój wirtualny asystent Wiktor przejmuje weryfikację i kwalifikację leadów w kanałach komunikacji. Prowadzi klienta wzdłuż lejków afiliacyjnych oraz ofertowych, a Ty otrzymujesz gotowy, gorący kontakt.
              </p>
              <ul style="list-style: none; padding: 0; color: var(--charcoal); font-size: 0.9rem; display: grid; gap: 8px;">
                <li style="display: flex; align-items: center; gap: 8px;"><span style="color: #3B82F6;">✓</span> Automatyczne prowadzenie rozmowy</li>
                <li style="display: flex; align-items: center; gap: 8px;"><span style="color: #3B82F6;">✓</span> Segmentacja i asynchroniczny routing</li>
                <li style="display: flex; align-items: center; gap: 8px;"><span style="color: #3B82F6;">✓</span> Powiadomienia na WhatsApp/Signal</li>
              </ul>
            </div>

            <!-- System 2 -->
            <div class="glass-card system-item" style="background: rgba(5, 8, 20, 0.5); border: 1px solid rgba(6, 182, 212, 0.15);">
              <div class="system-icon-wrapper" style="color: #06B6D4;">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="22" y1="12" x2="18" y2="12"></line><line x1="6" y1="12" x2="2" y2="12"></line><line x1="12" y1="6" x2="12" y2="2"></line><line x1="12" y1="22" x2="12" y2="18"></line></svg>
              </div>
              <h3 style="color: #FFF; font-size: 1.4rem; margin-bottom: 15px;">Dział Operacyjny AI (Agent Hermes)</h3>
              <p style="color: var(--slate-gray); font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px;">
                Wirtualny COO Hermes dba o bazy wiedzy RAG (Obsidian/GCS), synchronizację Google Calendar i automatyzacje. Odpowiada na zapytania w 3 sekundy i zarządza Twoimi cron-jobami nawyków.
              </p>
              <ul style="list-style: none; padding: 0; color: var(--charcoal); font-size: 0.9rem; display: grid; gap: 8px;">
                <li style="display: flex; align-items: center; gap: 8px;"><span style="color: #06B6D4;">✓</span> Lokalne bazy RAG (Obsidian/GCS)</li>
                <li style="display: flex; align-items: center; gap: 8px;"><span style="color: #06B6D4;">✓</span> Cron-Joby dbające o osobiste nawyki</li>
                <li style="display: flex; align-items: center; gap: 8px;"><span style="color: #06B6D4;">✓</span> Bezpieczne integracje przez API i SSH</li>
              </ul>
            </div>

            <!-- System 3 -->
            <div class="glass-card system-item" style="background: rgba(5, 8, 20, 0.5); border: 1px solid rgba(59, 130, 246, 0.15);">
              <div class="system-icon-wrapper" style="color: #3B82F6;">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
              </div>
              <h3 style="color: #FFF; font-size: 1.4rem; margin-bottom: 15px;">Integracja CRM & Systeme.io</h3>
              <p style="color: var(--slate-gray); font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px;">
                Wykorzystujemy darmowy plan Systeme.io do bezpiecznej wysyłki kampanii e-mailowych i budowy lejków, zapobiegając banom domen. Pełna synchronizacja kontaktów i tagów w tle przez n8n.
              </p>
              <ul style="list-style: none; padding: 0; color: var(--charcoal); font-size: 0.9rem; display: grid; gap: 8px;">
                <li style="display: flex; align-items: center; gap: 8px;"><span style="color: #3B82F6;">✓</span> Strategia „Jednego Taga” dla obniżenia kosztów</li>
                <li style="display: flex; align-items: center; gap: 8px;"><span style="color: #3B82F6;">✓</span> Integracja z formularzami i kampaniami</li>
                <li style="display: flex; align-items: center; gap: 8px;"><span style="color: #3B82F6;">✓</span> Bezpieczny e-mail marketing (brak spamu)</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Secure Phone Section (Projekt Mercury / E-book) -->
      <section id="secure-phone" style="padding: 100px 0; background: #050814; border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
        <div class="container">
          <div style="display: flex; align-items: center; gap: 60px; flex-wrap: wrap;">
            <div style="flex: 1.2; min-width: 320px;">
              <span style="color: #F59E0B; font-size: 0.85rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.15em;">Prywatność i Optymalizacja Telefonu</span>
              <h2 style="font-size: 2.8rem; color: #FFF; margin-top: 10px; margin-bottom: 25px; font-weight: 700;">Zwolnij zasoby swojego smartfona i pozbądź się śledzenia.</h2>
              <p style="color: var(--slate-gray); font-size: 1.15rem; line-height: 1.7; margin-bottom: 20px;">
                Zainstalowałem na starym telefonie Android czysty system bez telemetrii Google, podpiąłem prywatny DNS Mullvad oraz VPN. Efekt? **Brak reklam, urządzenie działające dwukrotnie szybciej na jednym ładowaniu baterii** oraz absolutne bezpieczeństwo przed skryptami śledzącymi.
              </p>
              <p style="color: var(--slate-gray); font-size: 1.05rem; line-height: 1.7; margin-bottom: 35px;">
                Opisałem całą procedurę instalacji krok po kroku w bezpłatnym e-booku **"Prywatna Twierdza"**. Zamiast zostawiać swój e-mail do marketingu, pobierz go bezpośrednio na naszej bezpiecznej infrastrukturze.
              </p>
